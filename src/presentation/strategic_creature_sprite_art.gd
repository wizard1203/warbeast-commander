	_p(c, [Vector2(-11, -31), Vector2(-37, -56 - flap), Vector2(-26, -36), Vector2(-20, -27)], Color("be795b"))
	_l(c, -10, -29, -39, -59 - flap, Color("e0b47c"), 2)
	_l(c, -10, -29, -38, -34, Color("d39a69"), 1)
