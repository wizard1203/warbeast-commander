static func _fallen(c: Object, unit: Dictionary) -> void:
	var owner := Palette.side_color(str(unit.get("side", "PLAYER")))
	match str(unit.get("unit_type", "")):
		"oath_cavalry":
			_p(c, [Vector2(-33, -12), Vector2(-18, -19), Vector2(14, -15), Vector2(33, -7), Vector2(32, 3), Vector2(-26, 5)], INK)
			_p(c, [Vector2(-29, -10), Vector2(-17, -16), Vector2(13, -12), Vector2(29, -6), Vector2(28, 1), Vector2(-25, 2)], Color("8e7654"))
			_r(c, -17, -14, 22, 11, owner.darkened(0.15))
			_r(c, -7, -21, 11, 8, METAL_DARK)
			_r(c, -17, -20, 8, 9, owner)
			_l(c, -15, 4, -33, 8, Color("665a48"), 3)
			_l(c, 12, 1, 28, 7, Color("665a48"), 3)
			_l(c, -22, -16, 42, -16, Color("a38d64"), 2)
		"stitched_guard":
			_p(c, [Vector2(-30, -12), Vector2(-14, -22), Vector2(9, -19), Vector2(25, -8), Vector2(19, 5), Vector2(-22, 6)], INK)
			_r(c, -21, -16, 34, 17, Color("867e6f"))
			_r(c, -24, -13, 11, 10, owner)
			_r(c, 9, -10, 11, 9, owner)
			_r(c, -6, -15, 13, 11, BONE)
			for y: int in [-13, -9, -5]: _r(c, -5, y, 11, 1, INK_SOFT)
			_r(c, 15, -18, 14, 10, BONE)
			_r(c, 19, -15, 3, 3, INK)
			_l(c, -30, 4, 29, 2, LEATHER, 3)
