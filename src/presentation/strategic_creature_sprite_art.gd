	_r(c, -13, -61, 1, 7, Color("d5dfcc"))
	_l(c, 4, -43, 20 + strike, -45, Color("b5a7be"), 3)
	_l(c, 15, -39, 34 + strike, -57 + int(strike / 2), INK, 3)
	_l(c, 15, -40, 34 + strike, -58 + int(strike / 2), Color("a897bd"), 1)
	_p(c, [Vector2(30 + strike, -58), Vector2(35 + strike, -64 + int(strike / 2)), Vector2(38 + strike, -57), Vector2(34 + strike, -53)], Color("a0c4bb"))
