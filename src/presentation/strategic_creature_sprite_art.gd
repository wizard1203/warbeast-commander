extends RefCounted
## Original right-facing source pixels for the six large troop silhouettes.
## Coordinates are relative to a real footpoint, not a physical collision body.
## A bounded presentation cache owns rasterization, mirroring and frame choice.
const Palette = preload("res://src/presentation/strategic_side_palette.gd")
const INK := Color("202a30")
const INK_SOFT := Color("384147")
const METAL := Color("c6d4d2")
const METAL_DARK := Color("6e8588")
const GOLD := Color("d6b879")
const LEATHER := Color("74533b")
const BONE := Color("d3c7aa")
const BONE_LIGHT := Color("f0e1bf")

static func supported_ids() -> PackedStringArray:
	return PackedStringArray(["oath_cavalry", "stitched_guard", "gear_engine", "stag_rider", "fire_dragon", "tunnel_rider"])

static func paint(canvas: Object, unit: Dictionary, pose: Dictionary) -> void:
	if str(pose.get("action", "IDLE")) == "FALLEN":
		_fallen(canvas, unit)
		return
	var owner := Palette.side_color(str(unit.get("side", "PLAYER")))
	var stride := int(round(clampf(float(pose.get("step", 0)), -1, 1) * 3))
	var strike := 0
	if str(pose.get("action", "IDLE")) == "ATTACK":
		strike = int(round(sin(clampf(float(pose.get("phase", 0)), 0, 1) * PI) * 7))
	match str(unit.get("unit_type", "")):
		"oath_cavalry": _oath_cavalry(canvas, owner, stride, strike)
		"stitched_guard": _stitched_guard(canvas, owner, stride, strike)
		"gear_engine": _gear_engine(canvas, owner, stride, strike)
		"stag_rider": _stag_rider(canvas, owner, stride, strike)
		"fire_dragon": _fire_dragon(canvas, owner, stride, strike)
		"tunnel_rider": _tunnel_rider(canvas, owner, stride, strike)

static func _oath_cavalry(c: Object, owner: Color, stride: int, strike: int) -> void:
	# Tall plated horse, enclosed knight, broad shield and a long pennant lance.
	_l(c, -27, -24, -38, -12, INK, 7)
	_l(c, -28, -24, -37, -15, Color("574332"), 4)
	_r(c, -41, -15, 7, 3, Color("372f29"))
	for leg: Vector2i in [Vector2i(-24, stride), Vector2i(-13, -stride), Vector2i(10, -stride), Vector2i(20, stride)]:
		_p(c, [Vector2(leg.x - 3, -17), Vector2(leg.x + 3, -17), Vector2(leg.x + leg.y + 2, 4), Vector2(leg.x + leg.y - 3, 4)], INK)
		_r(c, leg.x - 1, -15, 3, 9, Color("ae9672"))
		_r(c, leg.x + leg.y - 3, 3, 7, 4, Color("3e3b37"))
