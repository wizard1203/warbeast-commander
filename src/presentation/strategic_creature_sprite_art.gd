static func _tunnel_rider(c: Object, owner: Color, stride: int, strike: int) -> void:
	# Low six-legged cavern reptile, huge segmented tail and crystal saddle.
	_p(c, [Vector2(-23, -21), Vector2(-35, -18), Vector2(-46, -25), Vector2(-47, -19), Vector2(-36, -10), Vector2(-22, -11)], INK)
	_p(c, [Vector2(-23, -18), Vector2(-35, -15), Vector2(-44, -21), Vector2(-35, -12), Vector2(-23, -13)], Color("70758a"))
	for x: int in [-38, -33, -28]: _l(c, x, -18, x + 2, -13, Color("a2a0b7"), 1)
	for leg: Vector2i in [Vector2i(-24, stride), Vector2i(-7, -stride), Vector2i(13, stride)]:
		_l(c, leg.x, -18, leg.x - 7 - leg.y, -6, INK, 5)
		_l(c, leg.x - 7 - leg.y, -6, leg.x + 1 - leg.y, 3, INK, 4)
		_l(c, leg.x, -17, leg.x - 6 - leg.y, -6, Color("626a79"), 2)
		_r(c, leg.x - 2 - leg.y, 2, 9, 3, Color("b2b29e"))
	_p(c, [Vector2(-31, -27), Vector2(-20, -34), Vector2(10, -32), Vector2(23, -24), Vector2(21, -14), Vector2(-23, -12), Vector2(-31, -18)], INK)
	_p(c, [Vector2(-28, -26), Vector2(-19, -31), Vector2(9, -29), Vector2(20, -23), Vector2(18, -17), Vector2(-22, -15), Vector2(-28, -19)], Color("858294"))
	_p(c, [Vector2(-23, -19), Vector2(17, -20), Vector2(18, -17), Vector2(-23, -15)], Color("b0a6ad"))
	for x: int in [-24, -16, -8, 0, 8]:
		_r(c, x, -26, 5, 2, Color("a29db0"))
		_r(c, x + 3, -22, 4, 2, Color("636b80"))
		_p(c, [Vector2(x, -31), Vector2(x + 2, -37), Vector2(x + 5, -30)], Color("aca3bc"))
	_p(c, [Vector2(13, -28), Vector2(26, -35), Vector2(39 + strike, -30), Vector2(46, -24), Vector2(43 + int(strike / 3), -17), Vector2(26, -15), Vector2(17, -19)], INK)
	_p(c, [Vector2(17, -27), Vector2(27, -32), Vector2(38 + strike, -28), Vector2(43, -24), Vector2(40 + int(strike / 3), -20), Vector2(27, -18), Vector2(20, -21)], Color("8e899d"))
	_r(c, 27, -28, 5, 3, INK)
	_r(c, 28, -28, 3, 2, Color("b2d4b5"))
	_r(c, 40, -25, 3, 1, Color("ccc2b0"))
	_l(c, 29, -20, 42 + int(strike / 3), -21, INK, 2)
	for x: int in [31, 36, 40]: _r(c, x, -21, 1, 2, BONE_LIGHT)
	for leg: Vector2i in [Vector2i(-19, -stride), Vector2i(0, stride), Vector2i(18, -stride)]:
		_l(c, leg.x, -17, leg.x + 7 + leg.y, -6, INK, 5)
		_l(c, leg.x + 7 + leg.y, -6, leg.x + 1 + leg.y, 6, INK, 4)
		_l(c, leg.x, -16, leg.x + 6 + leg.y, -6, Color("9294a3"), 2)
		_r(c, leg.x - 1 + leg.y, 5, 9, 3, Color("d1cbb3"))
		_r(c, leg.x + leg.y, 6, 1, 3, Color("7d776b"))
	# Saddle and tunic are independent team surfaces, not a whole-body tint.
	_r(c, -17, -34, 28, 16, INK)
	_r(c, -15, -32, 24, 12, owner)
	_r(c, -15, -32, 24, 2, owner.lightened(0.26))
	_r(c, -15, -22, 24, 2, owner.darkened(0.34))
	_r(c, -13, -30, 2, 8, Color("c1acc9"))
	_r(c, 5, -30, 2, 8, Color("c1acc9"))
	_r(c, -7, -36, 16, 5, LEATHER)
	_p(c, [Vector2(-8, -50), Vector2(5, -50), Vector2(9, -37), Vector2(4, -31), Vector2(-8, -34)], INK)
	_r(c, -6, -48, 12, 15, Color("6d657d"))
	_r(c, -5, -47, 10, 9, owner)
	_r(c, -5, -47, 10, 2, owner.lightened(0.26))
	_l(c, 0, -35, 3, -20, Color("454250"), 3)
	_r(c, 2, -22, 7, 3, Color("b6a7bd"))
	_r(c, -7, -60, 14, 12, INK)
	_r(c, -5, -58, 10, 9, Color("b5a7be"))
	_r(c, -5, -58, 10, 3, Color("746b85"))
	_r(c, -4, -54, 8, 2, INK)
	_r(c, 1, -54, 3, 1, Color("b6d8c8"))
	_l(c, -5, -58, -10, -64, Color("c1aacb"), 2)
	_l(c, 3, -59, 8, -64, Color("c1aacb"), 2)
