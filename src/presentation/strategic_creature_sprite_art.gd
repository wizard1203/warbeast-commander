			_r(c, -23, -29, 8, 17, Color("9c7f52"))
		"stag_rider":
			_p(c, [Vector2(-29, -11), Vector2(-15, -18), Vector2(16, -15), Vector2(32, -6), Vector2(26, 3), Vector2(-26, 3)], INK)
			_p(c, [Vector2(-25, -10), Vector2(-14, -15), Vector2(15, -12), Vector2(28, -5), Vector2(24, 1), Vector2(-23, 1)], Color("99916a"))
			_r(c, -15, -13, 22, 10, owner)
			_r(c, -9, -22, 10, 8, owner)
			_l(c, 22, -8, 31, -22, Color("d0c39a"), 2)
			_l(c, 28, -18, 24, -24, Color("d0c39a"), 2)
			_l(c, 28, -18, 36, -20, Color("d0c39a"), 2)
			_l(c, -21, 1, -32, 8, Color("68664d"), 2)
			_l(c, 8, 1, 24, 7, Color("68664d"), 2)
		"fire_dragon":
			_p(c, [Vector2(-42, -18), Vector2(-14, -29), Vector2(7, -16), Vector2(34, -24), Vector2(43, -3), Vector2(4, 2), Vector2(-35, 4)], INK)
			_p(c, [Vector2(-37, -16), Vector2(-14, -25), Vector2(5, -13), Vector2(32, -20), Vector2(37, -4), Vector2(4, -1), Vector2(-31, 1)], Color("9d624b"))
			_p(c, [Vector2(-18, -10), Vector2(5, -16), Vector2(27, -10), Vector2(38, -3), Vector2(25, 4), Vector2(-16, 4), Vector2(-38, 9)], Color("b58558"))
			_r(c, -12, -17, 10, 9, owner)
			_r(c, 4, -17, 10, 9, owner)
			_l(c, -37, -16, -7, -7, Color("cf9e6d"), 2)
