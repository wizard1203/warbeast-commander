			_r(c, 29, -9, 3, 2, INK)

static func _r(c: Object, x: int, y: int, width: int, height: int, color: Color) -> void:
	c.draw_rect(Rect2(x, y, width, height), color)

static func _l(c: Object, ax: int, ay: int, bx: int, by: int, color: Color, width: int) -> void:
	c.draw_line(Vector2(ax, ay), Vector2(bx, by), color, width)

static func _p(c: Object, points: Array, color: Color) -> void:
	c.draw_colored_polygon(PackedVector2Array(points), color)
