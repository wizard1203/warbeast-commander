extends RefCounted
## Original M24 troop pixel recipes. A right-facing, foot-anchored painter only:
## no scene state, clock, random generator, authority, shadow or selection ring.
## One logical pixel is one brush pixel, not a scaled-up legacy body pixel.
const Palette = preload("res://src/presentation/strategic_side_palette.gd")
const INK := Color("19252b")
const STEEL := Color("a7b8b6")
const STEEL_LIGHT := Color("d9e2d4")
const STEEL_DARK := Color("596d73")
const WOOD := Color("936d49")
const WOOD_DARK := Color("534735")
const BRASS := Color("c4a368")
const SKIN := Color("d4af87")
const SKIN_LIGHT := Color("e9c89d")
const BONE := Color("c6c6aa")
const BONE_LIGHT := Color("e3dfc1")
const LEAF := Color("6e9564")
const LEAF_LIGHT := Color("a2bd7d")
const TEAL := Color("80c8be")
const VIOLET := Color("a89bbe")
const IDS := ["worker", "hinge_guard", "bright_crossbow", "iron_lancer", "grove_mender", "ash_guard", "bone_archer", "ember_mender", "rivet_guard", "shard_gunner", "repair_drone", "vine_guard", "leaf_archer", "root_mender", "ridge_guard", "stone_slinger", "rune_keeper", "chitin_guard", "echo_shooter", "spore_mender"]


static func supported_ids() -> PackedStringArray:
	return PackedStringArray(IDS)


static func paint(canvas: Object, unit: Dictionary, pose: Dictionary) -> void:
	var type := str(unit.get("unit_type", "hinge_guard"))
	if type not in IDS: return
	var owner := Palette.side_color(str(unit.get("side", "PLAYER")))
	var action := str(pose.get("action", "IDLE"))
	var step := int(round(clampf(float(pose.get("step", 0)), -1.0, 1.0) * 2.0))
	var phase := clampf(float(pose.get("phase", 0)), 0.0, 1.0)
	var exert := int(round(sin(phase * PI) * 6.0)) if action in ["ATTACK", "HEAL", "HARVEST", "MINE", "BUILD"] else 0
	if action == "FALLEN":
		_fallen(canvas, unit, owner)
		return
	match type:
		"worker": _worker(canvas, unit, owner, action, step, exert)
		"hinge_guard": _hinge_guard(canvas, owner, step, exert)
		"bright_crossbow": _bright_crossbow(canvas, owner, step, exert)
		"iron_lancer": _iron_lancer(canvas, owner, step, exert)
		"grove_mender": _grove_mender(canvas, owner, step, exert)
		"ash_guard": _ash_guard(canvas, owner, step, exert)
		"bone_archer": _bone_archer(canvas, owner, step, exert)
		"ember_mender": _ember_mender(canvas, owner, step, exert)
		"rivet_guard": _rivet_guard(canvas, owner, step, exert)
		"shard_gunner": _shard_gunner(canvas, owner, step, exert)
		"repair_drone": _repair_drone(canvas, owner, step, exert)
		"vine_guard": _vine_guard(canvas, owner, step, exert)
		"leaf_archer": _leaf_archer(canvas, owner, step, exert)
		"root_mender": _root_mender(canvas, owner, step, exert)
		"ridge_guard": _ridge_guard(canvas, owner, step, exert)
		"stone_slinger": _stone_slinger(canvas, owner, step, exert)
		"rune_keeper": _rune_keeper(canvas, owner, step, exert)
		"chitin_guard": _chitin_guard(canvas, owner, step, exert)
		"echo_shooter": _echo_shooter(canvas, owner, step, exert)
		"spore_mender": _spore_mender(canvas, owner, step, exert)
	_craft(canvas,type,owner,step)


static func _worker(c: Object, u: Dictionary, o: Color, a: String, s: int, e: int) -> void:
	# Broad brim, rolled sleeves and a full apron distinguish the civilian.
	_boots(c, s, Color("765943"), 4)
	_r(c, -7, -23, 15, 18, INK)
	_r(c, -6, -22, 13, 16, Color("b7a783"))
	_r(c, -5, -19, 11, 13, o)
	_r(c, -5, -19, 3, 12, o.lightened(0.18))
	_r(c, -2, -10, 6, 3, o.darkened(0.25))
	_r(c, -6, -8, 13, 3, WOOD_DARK)
	_r(c, 0, -8, 3, 2, BRASS)
	_r(c, -10, -24, 5, 11, INK)
	_r(c, -9, -23, 4, 6, Color("e4d6b4"))
	_r(c, -9, -17, 4, 5, SKIN)
	_r(c, 7, -23, 5, 11, INK)
	_r(c, 7, -22, 4, 5, Color("e4d6b4"))
	_r(c, 8, -17, 4, 5, SKIN_LIGHT)
	_face(c, -4, -35, SKIN, false)
	_r(c, -7, -38, 13, 5, INK)
	_r(c, -6, -38, 11, 4, Color("c9ac62"))
	_r(c, -12, -34, 24, 4, INK)
	_r(c, -11, -34, 22, 2, Color("e2cb84"))
	_r(c, -6, -36, 11, 3, o)
	_r(c, -10, -12, 4, 5, WOOD)
	_r(c, -10, -12, 4, 1, BRASS)
	var role := str(u.get("role", "RESERVE"))
	var working := a in ["HARVEST", "MINE", "BUILD"]
	var hand := Vector2(11, -17 - e)
	if a == "HARVEST" or (not working and role == "FOOD"):
		_l(c, hand, Vector2(19 - e, -6 - e), WOOD_DARK, 3)
		_l(c, hand, Vector2(19 - e, -6 - e), WOOD, 1)
		_p(c, [Vector2(17 - e,-14 - e),Vector2(24 - e,-17 - e),Vector2(24 - e,-12 - e),Vector2(19 - e,-10 - e)], INK)
		_l(c, Vector2(19 - e,-13 - e), Vector2(23 - e,-15 - e), STEEL_LIGHT, 2)
	elif a == "BUILD" or (not working and role == "CONSTRUCTION_REPAIR"):
		_l(c, hand, Vector2(17 - e,-30 - e), WOOD_DARK, 3)
		_r(c, 12 - e, -34 - e, 12, 6, INK)
		_r(c, 13 - e, -34 - e, 10, 4, STEEL)
		_r(c, 13 - e, -34 - e, 10, 1, STEEL_LIGHT)
	else:
		_l(c, hand, Vector2(16 - e,-34 - e), WOOD_DARK, 3)
		_l(c, hand, Vector2(16 - e,-34 - e), WOOD, 1)
		_l(c, Vector2(9 - e,-35 - e),Vector2(24 - e,-32 - e),INK,4)
		_l(c, Vector2(9 - e,-35 - e),Vector2(24 - e,-32 - e),STEEL,2)
		_r(c, 9 - e, -36 - e, 5, 1, STEEL_LIGHT)
	if int(u.get("cargo_amount", 0)) > 0:
		_r(c, -16, -24, 8, 17, INK)
		_r(c, -15, -23, 6, 15, WOOD)
		for y: int in [-21,-17,-13]: _r(c, -15, y, 6, 2, WOOD_DARK)
		var cargo := Color("d8c378") if str(u.get("cargo_type", "")) == "FOOD" else STEEL
		_r(c, -15, -26, 4, 4, cargo)
		_r(c, -11, -25, 3, 3, cargo.lightened(0.15))


static func _hinge_guard(c: Object, o: Color, s: int, e: int) -> void:
	_boots(c, s, STEEL_DARK, 4)
	_r(c, -7, -24, 15, 19, INK)
	_r(c, -6, -23, 13, 16, STEEL)
	_r(c, -3, -22, 8, 14, o)
	_r(c, -2, -22, 2, 12, o.lightened(0.25))
	_r(c, -7, -9, 15, 3, WOOD_DARK)
	_r(c, -9, -28, 8, 7, INK)
	_r(c, -8, -27, 6, 5, o)
	_r(c, 3, -28, 8, 8, INK)
	_r(c, 4, -27, 6, 5, o)
	_r(c, 5, -27, 5, 1, o.lightened(0.25))
	_r(c, -5, -39, 11, 14, INK)
	_r(c, -4, -38, 9, 12, STEEL)
	_r(c, -4, -38, 3, 9, STEEL_LIGHT)
	_r(c, -3, -33, 8, 3, INK)
	_r(c, 2, -30, 3, 3, STEEL_DARK)
	_r(c, -3, -41, 7, 3, STEEL_DARK)
	# A clearly split hinged kite shield, rather than a tiny generic square.
	_p(c, [Vector2(-20,-25),Vector2(-7,-27),Vector2(-6,-8),Vector2(-13,-2),Vector2(-20,-9)], INK)
	_p(c, [Vector2(-19,-24),Vector2(-8,-25),Vector2(-8,-9),Vector2(-13,-4),Vector2(-18,-10)], o)
	_l(c, Vector2(-13,-25),Vector2(-13,-5),BRASS,2)
	_r(c, -18, -22, 4, 2, o.lightened(0.25))
	_r(c, -15, -19, 4, 3, STEEL)
	_r(c, -15, -12, 4, 3, STEEL)
	_l(c, Vector2(10,-17),Vector2(15 + e,-34 + e), INK,4)
	_l(c, Vector2(10,-17),Vector2(15 + e,-34 + e), STEEL_LIGHT,2)
	_l(c, Vector2(7,-18),Vector2(14,-16), BRASS,3)
	_r(c, 8, -16, 3, 5, WOOD_DARK)


static func _bright_crossbow(c: Object, o: Color, s: int, e: int) -> void:
	_boots(c, s, WOOD_DARK, 4)
	# Long back quiver and pointed hood read differently from plated infantry.
	_r(c, -13, -34, 6, 24, INK)
	_r(c, -12, -30, 4, 18, WOOD)
	for x: int in [-12,-9]:
		_l(c, Vector2(x,-29),Vector2(x-1,-40),STEEL,1)
		_r(c, x-2, -40, 3, 3, Color("ded9bb"))
	_p(c, [Vector2(-8,-26),Vector2(6,-26),Vector2(9,-6),Vector2(-8,-7)], INK)
	_r(c, -6, -24, 12, 16, Color("6e675a"))
	_r(c, -7, -25, 5, 11, o)
	_r(c, 3, -25, 6, 11, o)
	_r(c, -3, -17, 7, 9, o)
	_l(c, Vector2(-5,-24),Vector2(4,-9),WOOD_DARK,3)
	_r(c, -5, -10, 12, 3, WOOD_DARK)
	_r(c, 0, -10, 3, 2, BRASS)
	_p(c, [Vector2(-6,-31),Vector2(-4,-41),Vector2(2,-43),Vector2(7,-37),Vector2(7,-29)], INK)
	_p(c, [Vector2(-5,-32),Vector2(-3,-40),Vector2(2,-41),Vector2(5,-36),Vector2(5,-30)], o.darkened(0.3))
	_r(c, -1, -36, 6, 7, SKIN)
	_r(c, 3, -34, 2, 2, INK)
	_r(c, -1, -30, 6, 2, WOOD_DARK)
	# Shoulder stock, broad bow limbs, taut string and separate bolt rail.
	var recoil := -int(e / 2)
	_r(c, 4 + recoil, -20, 18, 5, INK)
	_r(c, 5 + recoil, -20, 16, 3, WOOD)
	_r(c, 5 + recoil, -21, 18, 1, STEEL_LIGHT)
	_l(c, Vector2(15+recoil,-29),Vector2(20+recoil,-19),INK,3)
	_l(c, Vector2(20+recoil,-19),Vector2(15+recoil,-8),INK,3)
	_l(c, Vector2(15+recoil,-28),Vector2(19+recoil,-19),BRASS,1)
	_l(c, Vector2(19+recoil,-19),Vector2(15+recoil,-9),BRASS,1)
	_l(c, Vector2(15+recoil,-28),Vector2(15+recoil,-9),Color("d7d5b6"),1)
	_r(c, 8 + recoil, -16, 4, 5, WOOD_DARK)
	_r(c, 7, -20, 4, 4, SKIN_LIGHT)


static func _iron_lancer(c: Object, o: Color, s: int, e: int) -> void:
	_boots(c, s, STEEL_DARK, 5)
	_r(c, -9, -27, 19, 19, INK)
	_r(c, -8, -25, 17, 15, STEEL_DARK)
	_r(c, -7, -25, 5, 14, STEEL)
	_r(c, 3, -25, 5, 14, STEEL)
	_r(c, -2, -25, 5, 16, o)
	_r(c, -8, -11, 17, 3, BRASS.darkened(0.25))
	_p(c, [Vector2(-8,-9),Vector2(-1,-9),Vector2(-2,1),Vector2(-9,-1)], o)
	_p(c, [Vector2(2,-9),Vector2(9,-9),Vector2(10,-1),Vector2(3,1)], o)
	_r(c, -12, -30, 10, 9, INK)
	_r(c, -11, -29, 8, 6, STEEL)
	_r(c, -10, -29, 6, 2, STEEL_LIGHT)
	_r(c, 3, -30, 10, 9, INK)
	_r(c, 4, -29, 8, 6, o)
	_r(c, 4, -29, 8, 2, o.lightened(0.2))
	_r(c, -6, -41, 13, 14, INK)
	_r(c, -5, -40, 11, 12, STEEL)
	_r(c, -4, -40, 3, 10, STEEL_LIGHT)
	_r(c, -4, -35, 10, 2, INK)
	_r(c, 1, -34, 2, 5, STEEL_DARK)
	_r(c, -2, -45, 5, 5, BRASS)
	_r(c, -1, -45, 3, 4, o)
	var shift := int(e / 2)
	_l(c, Vector2(9,-1),Vector2(14 + shift,-47),INK,4)
	_l(c, Vector2(9,-1),Vector2(14 + shift,-47),WOOD,2)
	_p(c, [Vector2(11+shift,-46),Vector2(16+shift,-54),Vector2(18+shift,-45),Vector2(15+shift,-42)], INK)
	_p(c, [Vector2(13+shift,-46),Vector2(16+shift,-52),Vector2(16+shift,-44)], STEEL_LIGHT)
	_r(c, 8, -21, 5, 5, STEEL)
	_l(c, Vector2(-8,-18),Vector2(11,-19),STEEL_DARK,5)
	_r(c, 6, -21, 5, 4, STEEL_LIGHT)


static func _grove_mender(c: Object, o: Color, s: int, e: int) -> void:
	# A long light apron/stole, open head and lantern crook are not a soldier.
	_boots(c, s, WOOD_DARK, 3)
	_p(c, [Vector2(-7,-27),Vector2(6,-27),Vector2(10,-2),Vector2(-10,-2)], INK)
	_p(c, [Vector2(-6,-26),Vector2(5,-26),Vector2(8,-3),Vector2(-8,-3)], Color("d1d2b0"))
	_r(c, -7, -27, 5, 17, o)
	_r(c, 3, -27, 5, 17, o)
	_r(c, -6, -26, 2, 15, o.lightened(0.2))
	_r(c, 4, -26, 2, 15, o.lightened(0.2))
	_r(c, -6, -11, 13, 3, WOOD_DARK)
	_r(c, -2, -11, 4, 3, BRASS)
	_face(c, -4, -38, SKIN, false)
	_r(c, -5, -40, 11, 5, WOOD_DARK)
	_r(c, -6, -37, 13, 3, LEAF)
	_r(c, -2, -39, 3, 4, LEAF_LIGHT)
	_r(c, -11, -23, 5, 13, INK)
	_r(c, -10, -22, 4, 9, Color("d1d2b0"))
	_r(c, -13, -14, 8, 10, WOOD_DARK)
	_r(c, -12, -13, 6, 8, WOOD)
	_r(c, -11, -12, 4, 3, Color("d4cca6"))
	_l(c, Vector2(10,-15),Vector2(13,-41-e),WOOD_DARK,4)
	_l(c, Vector2(10,-15),Vector2(13,-41-e),WOOD,2)
	_l(c, Vector2(13,-41-e),Vector2(19,-44-e),WOOD,3)
	_l(c, Vector2(19,-44-e),Vector2(22,-39-e),WOOD,3)
	_r(c, 18, -39-e, 6, 8, INK)
	_r(c, 19, -38-e, 4, 6, TEAL)
	_r(c, 20, -37-e, 2, 3, STEEL_LIGHT)
	_p(c, [Vector2(12,-37-e),Vector2(5,-39-e),Vector2(7,-34-e)], LEAF)
	_r(c, 8, -19, 5, 5, SKIN_LIGHT)


static func _ash_guard(c: Object, o: Color, s: int, e: int) -> void:
	_bone_legs(c, s)
	_r(c, -6, -27, 12, 19, INK)
	_r(c, -4, -25, 8, 14, Color("766b78"))
	_r(c, -1, -26, 2, 18, BONE)
	for y: int in [-24,-20,-16]:
		_l(c, Vector2(-5,y),Vector2(5,y+1),BONE,2)
	_r(c, -10, -28, 7, 8, INK)
	_r(c, -9, -27, 5, 6, o)
	_r(c, 4, -28, 7, 8, INK)
	_r(c, 5, -27, 5, 6, o)
	_r(c, -4, -11, 9, 7, o)
	_r(c, -4, -11, 3, 6, o.lightened(0.15))
	_skull(c, -5, -40, false)
	_r(c, -7, -40, 13, 2, Color("6f6171"))
	_r(c, -6, -43, 4, 4, STEEL_DARK)
	_p(c, [Vector2(-18,-23),Vector2(-8,-25),Vector2(-6,-10),Vector2(-13,-6),Vector2(-19,-12)], INK)
	_p(c, [Vector2(-17,-22),Vector2(-9,-23),Vector2(-8,-11),Vector2(-13,-8),Vector2(-17,-12)], o)
	_r(c, -18, -20, 3, 5, STEEL_DARK)
	_r(c, -14, -18, 3, 3, BONE)
	_l(c, Vector2(8,-19),Vector2(13+e,-33+e),INK,5)
	_l(c, Vector2(8,-19),Vector2(13+e,-33+e),BONE,3)
	_p(c, [Vector2(12+e,-33+e),Vector2(19+e,-34+e),Vector2(14+e,-28+e)], BONE_LIGHT)
	_r(c, 7, -20, 4, 5, BONE)
	_r(c, -3, -9, 3, 3, BRASS)


static func _bone_archer(c: Object, o: Color, s: int, e: int) -> void:
	_bone_legs(c, s)
	_r(c, -12, -34, 5, 24, INK)
	_r(c, -11, -32, 3, 21, Color("665b6c"))
	for x: int in [-12,-9]: _l(c,Vector2(x,-31),Vector2(x-1,-42),BONE_LIGHT,1)
	_r(c, -5, -28, 11, 19, INK)
	_r(c, -4, -26, 8, 15, Color("655b70"))
	for y: int in [-25,-21,-17]: _r(c,-4,y,9,2,BONE)
	_r(c, -1, -28, 2, 18, BONE_LIGHT)
	_r(c, -8, -29, 6, 8, o)
	_r(c, 3, -29, 6, 8, o)
	_r(c, -4, -10, 9, 8, o)
	_r(c, -3, -10, 2, 7, o.lightened(0.2))
	_skull(c, -4, -42, true)
	_r(c, -5, -42, 5, 2, Color("76667b"))
	# Rib bow is a tall crooked shape; existing projectile rules remain arrows.
	var recoil := -int(e / 2)
	_l(c, Vector2(13+recoil,-42),Vector2(21+recoil,-29),INK,4)
	_l(c, Vector2(21+recoil,-29),Vector2(20+recoil,-17),INK,4)
	_l(c, Vector2(20+recoil,-17),Vector2(12+recoil,-3),INK,4)
	_l(c, Vector2(13+recoil,-41),Vector2(20+recoil,-28),BONE_LIGHT,2)
	_l(c, Vector2(20+recoil,-28),Vector2(19+recoil,-17),BONE,2)
	_l(c, Vector2(19+recoil,-17),Vector2(12+recoil,-4),BONE_LIGHT,2)
	_l(c, Vector2(13+recoil,-41),Vector2(12+recoil,-4),Color("c9c1a1"),1)
	_l(c, Vector2(3,-20),Vector2(23+recoil,-20),STEEL,1)
	_r(c, 7, -22, 5, 4, BONE)
	_r(c, 0, -22, 5, 4, BONE)


