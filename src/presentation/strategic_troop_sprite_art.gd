static func _bug_legs(c: Object, s: int, material: Color) -> void:
	for pair: int in range(3):
		var y := -18 + pair * 5
		var stride := s if pair % 2 == 0 else -s
		for side: int in [-1,1]:
			var knee := Vector2(side*(16+stride),y+5)
			var toe := Vector2(side*(21+stride),4-pair)
			_l(c,Vector2(side*6,y),knee,INK,4)
			_l(c,knee,toe,INK,3)
			_l(c,Vector2(side*6,y),knee,material,2)
			_l(c,knee,toe,material.lightened(0.2),1)
			_r(c,int(toe.x)-2,int(toe.y),4,2,Color("bdadbb"))


static func _face(c: Object, x: int, y: int, skin: Color, pointed: bool) -> void:
	_r(c,x-1,y-1,12,13,INK)
	_r(c,x,y,10,11,skin)
	_r(c,x,y,3,8,skin.lightened(0.15))
	_r(c,x+7,y+4,3,2,INK)
	_r(c,x+8,y+7,3,2,skin.darkened(0.15))
	_r(c,x+3,y+10,6,2,skin.darkened(0.25))
	if pointed:
		_p(c,[Vector2(x+8,y+3),Vector2(x+15,y),Vector2(x+10,y+8)],skin)
		_l(c,Vector2(x+10,y+3),Vector2(x+13,y+2),skin.darkened(0.2),1)


static func _skull(c: Object, x: int, y: int, elongated: bool) -> void:
	var h := 13 if elongated else 11
	_r(c,x-1,y-1,13,h+3,INK)
	_r(c,x,y,11,h,BONE)
	_r(c,x,y,3,h-2,BONE_LIGHT)
	_r(c,x+2,y+4,3,3,INK)
	_r(c,x+7,y+4,4,3,INK)
	_r(c,x+3,y+5,1,1,TEAL)
	_r(c,x+8,y+5,1,1,TEAL)
	_r(c,x+6,y+8,2,2,INK)
	_r(c,x+3,y+h,8,2,BONE_LIGHT)
	for tooth: int in [3,6,9]: _r(c,x+tooth,y+h-1,1,3,INK)


static func _fallen(c: Object, u: Dictionary, o: Color) -> void:
	var type := str(u.get("unit_type", "worker"))
	var faction := str(u.get("faction_id", "HUMAN"))
	var shell := Color("7f7390") if faction == "UNDERGROUND" else STEEL_DARK if faction == "MACHINE" else Color("776d65")
	_r(c,-17,-7,31,11,INK)
	_r(c,-16,-6,28,9,shell)
	_r(c,-11,-6,12,7,o)
	_r(c,3,-6,8,7,o)
	_r(c,-10,-6,9,2,o.lightened(0.18))
	if faction == "UNDEAD":
		_r(c,12,-7,9,9,BONE)
		_r(c,17,-4,3,2,INK)
		for x: int in [-13,-8,-3]: _r(c,x,-5,2,8,BONE)
	elif faction == "MACHINE":
		_r(c,11,-9,12,10,INK)
		_r(c,12,-8,10,8,STEEL_DARK)
		_r(c,17,-6,5,2,TEAL)
		_r(c,-23,0,8,4,STEEL)
	elif faction == "UNDERGROUND":
		for x: int in [-13,-6,1]:
			_l(c,Vector2(x,-2),Vector2(x-6,6),VIOLET,2)
		_r(c,12,-6,9,8,Color("a797b0"))
		_r(c,18,-4,3,2,TEAL)
	else:
		_r(c,12,-7,9,9,SKIN)
		_r(c,18,-4,3,2,INK)
		_r(c,-23,0,9,4,WOOD_DARK)
	match type:
		"worker":
			_r(c,10,-10,15,3,Color("ddc47b"))
			_r(c,13,-13,9,4,Color("c2a665"))
		"bright_crossbow", "bone_archer", "leaf_archer":
			_l(c,Vector2(-15,-11),Vector2(17,-13),WOOD,2)
			_l(c,Vector2(3,-19),Vector2(7,-7),BONE if faction == "UNDEAD" else WOOD,2)
		"iron_lancer": _l(c,Vector2(-24,-13),Vector2(25,-13),STEEL,2)
		"grove_mender", "ember_mender", "root_mender", "rune_keeper", "spore_mender":
			_l(c,Vector2(-22,-12),Vector2(20,-12),WOOD,2)
			_r(c,-22,-17,7,8,TEAL if type != "rune_keeper" else BRASS)
		"rivet_guard", "ridge_guard", "hinge_guard", "vine_guard":
			_r(c,-23,-15,12,8,INK)
			_r(c,-22,-14,10,6,o)
		"shard_gunner", "echo_shooter":
			_r(c,-23,-13,24,5,INK)
			_r(c,-22,-12,22,3,STEEL)
		"repair_drone":
			_l(c,Vector2(-10,-7),Vector2(-16,-18),BRASS,3)
			_l(c,Vector2(-16,-18),Vector2(3,-17),STEEL,3)
		"chitin_guard":
			_l(c,Vector2(-17,-4),Vector2(-23,-15),BONE_LIGHT,3)
		"stone_slinger":
			_l(c,Vector2(-20,-15),Vector2(4,-17),WOOD,1)
			_r(c,-23,-16,5,5,STEEL)


