	_bone_legs(c, s)
	# Bent stitched cowl and a cold ember stove on the back.
	_r(c, -16, -31, 10, 20, INK)
	_r(c, -15, -30, 8, 18, Color("675b63"))
	_r(c, -14, -28, 6, 3, STEEL_DARK)
	_r(c, -14, -22, 6, 7, Color("ba7957"))
	for x: int in [-13,-10]: _r(c,x,-22,1,7,INK)
	_r(c, -13, -36, 4, 6, INK)
	_r(c, -12, -36, 2, 5, STEEL_DARK)
	_p(c, [Vector2(-7,-29),Vector2(5,-31),Vector2(11,-5),Vector2(-10,-4)], INK)
	_p(c, [Vector2(-6,-28),Vector2(4,-30),Vector2(9,-6),Vector2(-8,-5)], Color("776775"))
	_r(c, -6, -26, 5, 16, o)
	_r(c, 3, -27, 5, 17, o)
	for y: int in [-23,-18,-13]: _l(c,Vector2(-5,y),Vector2(7,y+1),BONE,1)
	_p(c, [Vector2(-5,-32),Vector2(-3,-42),Vector2(5,-43),Vector2(10,-34),Vector2(8,-28)], INK)
	_p(c, [Vector2(-4,-33),Vector2(-2,-41),Vector2(4,-41),Vector2(8,-34),Vector2(7,-29)], Color("675b6d"))
	_r(c, 1, -37, 6, 7, BONE)
	_r(c, 4, -35, 3, 2, INK)
	_r(c, 3, -30, 5, 2, BONE_LIGHT)
	_l(c, Vector2(12,-4),Vector2(15,-41-e),INK,4)
	_l(c, Vector2(12,-4),Vector2(15,-41-e),BONE,2)
	_l(c, Vector2(15,-41-e),Vector2(23,-45-e),BONE_LIGHT,2)
	_l(c, Vector2(23,-45-e),Vector2(24,-39-e),BONE,2)
	_r(c, 20, -39-e, 3, 6, Color("be8863"))
	_r(c, 10, -21, 5, 5, BONE)
	_r(c, -5, -8, 6, 5, BONE_LIGHT)
	_r(c, -4, -8, 4, 2, Color("a27d78"))


static func _rivet_guard(c: Object, o: Color, s: int, e: int) -> void:
	_robot_legs(c, s)
	_r(c, -9, -29, 19, 21, INK)
	_r(c, -8, -28, 17, 19, Color("8f7a65"))
	_r(c, -7, -27, 5, 16, STEEL_DARK)
	_r(c, -1, -27, 9, 15, o)
	_r(c, 0, -27, 7, 2, o.lightened(0.2))
	_r(c, -5, -9, 11, 4, INK)
	for x: int in [-7,6]:
		_r(c,x,-25,2,2,BRASS)
		_r(c,x,-13,2,2,BRASS)
	_r(c, -7, -42, 15, 12, INK)
	_r(c, -6, -41, 13, 10, STEEL_DARK)
	_r(c, -5, -40, 11, 2, STEEL)
	_r(c, -4, -36, 10, 3, INK)
	_r(c, -3, -36, 8, 2, TEAL)
	_r(c, -3, -45, 7, 3, BRASS)
	_r(c, -13, -31, 7, 8, INK)
	_r(c, -12, -30, 5, 6, o)
	_r(c, 7, -31, 7, 10, INK)
