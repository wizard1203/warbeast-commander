const BASE_UPGRADES := Balance.BASE_UPGRADES
static func get_catalog() -> Dictionary:
	var production_families := {}
	var required_buildings := {}
	for id: String in Balance.UNITS:
		var recipe: Dictionary = Balance.UNITS[id]
		production_families[id] = str(recipe.get("production_family", "HERO" if id == "hero" else "ECONOMY" if id == "worker" else ""))
		required_buildings[id] = recipe.get("required_buildings", []).duplicate(true)
	return {"version":VERSION,"population":POPULATION.duplicate(true),"unit_tiers":UNIT_TIERS.duplicate(true),"building_tiers":BUILDING_TIERS.duplicate(true),"base_upgrades":BASE_UPGRADES.duplicate(true),"production_families":production_families,"required_buildings":required_buildings}
