static func building(type: String, tier: int = 1) -> Dictionary:
	var result: Dictionary = WORLD_BUILDINGS.get(type, {}).duplicate(true)
	if type == "BASE" and BASE_UPGRADES.has(tier):
		result.hp = BASE_UPGRADES[tier].max_hp
		result.armor = BASE_UPGRADES[tier].armor
	return result
static func base_upgrade(tier: int) -> Dictionary: return BASE_UPGRADES.get(tier, {}).duplicate(true)
static func tech_quote(track: String, rank: int) -> Dictionary:
	if not TECH_RANKS.has(track) or rank < 1 or rank > TECH_RANKS[track].size(): return {}
	var result: Dictionary = TECH_RANKS[track][rank - 1].duplicate(true)
	result["rank"] = rank
	return result
