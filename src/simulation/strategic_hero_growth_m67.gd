static func has_hero(id:String)->bool:return ROWS.has(id)
static func growth(id:String)->Dictionary:
	if not ROWS.has(id):return {}
	var row:Array=ROWS[id]
	return {"max_hp":int(row[0]),"damage_numerator":int(row[1]),"damage_denominator":int(row[2]),"armor_every":int(row[3]),"max_mana":int(row[4])}
static func rationale(id:String)->String:return str(RATIONALES.get(id,""))
